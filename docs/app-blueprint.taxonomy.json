{
  "schema": "copdocx.blueprint.taxonomy.v1",
  "blueprintId": "COPDOCX-BP-1",
  "snapshotDate": "2026-08-31",
  "target": {
    "framework": "React + TypeScript",
    "router": "HashRouter",
    "runtimeNetworkRequired": false,
    "browserPersistence": "IndexedDB copdocx.workspace.v2",
    "supportedOrigin": "fixed local loopback or packaged desktop",
    "fileProtocolIsAcceptanceTarget": false,
    "legacyOriginMigration": "complete archive export from classic app, then first-run import"
  },
  "states": [
    { "id": "built", "meaning": "Present in the current modern app and included in parity scope." },
    { "id": "skeleton", "meaning": "Present, but placeholder or incomplete." },
    { "id": "intended", "meaning": "Canonical behavior for the React recreation." },
    { "id": "planned", "meaning": "Reserved and not presented as working." },
    { "id": "legacy", "meaning": "Reference or migration input only." }
  ],
  "modules": [
    { "id": "M-HOME", "name": "Home", "owns": [], "responsibility": "Read-only operational briefing." },
    { "id": "M-LEADS", "name": "Leads", "owns": ["E-LEAD", "E-PERSON", "E-CASE-VEHICLE", "E-LOCATION", "E-LINK", "E-FOLLOWUP"], "responsibility": "Subject-centered case snapshots and lead outputs." },
    { "id": "M-ENCOUNTERS", "name": "Encounters", "owns": ["E-ENCOUNTER", "E-PARTICIPANT", "E-NARRATIVE"], "responsibility": "Field events, booked participants, and I-213 narratives." },
    { "id": "M-BOOKIN", "name": "Book-in", "owns": ["E-BOOKIN"], "responsibility": "Detainee intake and output generation." },
    { "id": "M-MAP", "name": "Map", "owns": ["E-MAP-STATE"], "responsibility": "Workspace location projection, operational layers, views, and markup." },
    { "id": "M-ADMIN", "name": "Admin", "owns": ["E-OFFICER", "E-FLEET-VEHICLE", "E-SHIFT"], "responsibility": "Personnel, fleet, schedule, and summaries." },
    { "id": "M-MEDIA", "name": "Media", "owns": ["E-MEDIA"], "responsibility": "Owner-scoped uploaded photos and files." },
    { "id": "M-ARTIFACT", "name": "Artifacts", "owns": ["E-ARTIFACT"], "responsibility": "Versioned generated outputs and binary bytes." }
  ],
  "repositories": [
    { "id": "R-LEAD", "entity": "E-LEAD", "v2Store": "leads", "legacySources": ["localStorage:copdocx.store.v1/leads"] },
    { "id": "R-PEOPLE-INDEX", "entity": "E-PERSON", "v2Store": "peopleIndex", "derived": true, "legacySources": ["localStorage:copdocx.store.v1/people"] },
    { "id": "R-ENCOUNTER", "entity": "E-ENCOUNTER", "v2Store": "encounters", "legacySources": ["localStorage:copdocx.store.v1/encounters"] },
    { "id": "R-BOOKIN", "entity": "E-BOOKIN", "v2Store": "bookIns", "legacySources": ["localStorage:alien-book-in.saved-records.v1"] },
    { "id": "R-OFFICER", "entity": "E-OFFICER", "v2Store": "officers", "legacySources": ["localStorage:copdoc.admin.v1/officers"] },
    { "id": "R-FLEET", "entity": "E-FLEET-VEHICLE", "v2Store": "fleetVehicles", "legacySources": ["localStorage:copdoc.admin.v1/vehicles"] },
    { "id": "R-SHIFT", "entity": "E-SHIFT", "v2Store": "shifts", "legacySources": ["localStorage:copdoc.admin.v1/shifts"] },
    { "id": "R-MEDIA", "entity": "E-MEDIA", "v2Store": ["mediaMeta", "mediaBlobs"], "legacySources": ["IndexedDB:copdocx.media.v1"] },
    { "id": "R-ARTIFACT", "entity": "E-ARTIFACT", "v2Store": ["artifactMeta", "artifactBlobs"], "legacySources": ["generated downloads", "IndexedDB:copdocx.warrants directory handle"] },
    { "id": "R-SETTINGS", "entity": "E-SETTINGS", "v2Store": "settings", "legacySources": ["localStorage:copdocx.settings.v1"] },
    { "id": "R-MAP", "entity": "E-MAP-STATE", "v2Store": "mapState", "legacySources": ["localStorage:copdocx.map.views.v1", "localStorage:copdocx.map.layers.v1", "localStorage:copdocx.map.icons.v1", "localStorage:copdocx.map.markup.v1"] },
    { "id": "R-TEMPLATE", "entity": "E-NARRATIVE-TEMPLATE", "v2Store": "narrativeTemplates", "legacySources": ["localStorage:opdoc.narrative.templates.v2", "localStorage:opdoc.narrative.templates.v1"] }
  ],

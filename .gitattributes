# Pin LF only for Wave 1 tooling files.
# Do not enable `* text=auto` — that would renormalize the whole tree.

.gitattributes text eol=lf
.gitignore text eol=lf
.nvmrc text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
playwright.config.js text eol=lf
requirements-dev.txt text eol=lf

.github/** text eol=lf

scripts/verify.js text eol=lf
scripts/static-server.js text eol=lf
scripts/hash-manifest.js text eol=lf
scripts/package-release.js text eol=lf
scripts/check-integrity.js text eol=lf
scripts/lib/** text eol=lf
scripts/test-age.js text eol=lf
scripts/test-narrative-build9.js text eol=lf
tests/harness/** text eol=lf
